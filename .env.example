# Telegram (если не заполнен — дайджест печатается в консоль)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Расписание
COLLECT_INTERVAL_MIN=30
# Дайджест автоматически после каждого N-го сбора (окно = эти сборы)
# 0 — отключить, тогда дайджест по времени DIGEST_HOUR:DIGEST_MINUTE
DIGEST_EVERY_N_COLLECTS=2
DIGEST_HOUR=9
DIGEST_MINUTE=0

# Дайджест: топ 1–3 новости с каждого источника + общий лимит
DIGEST_MIN_PER_SOURCE=1
DIGEST_MAX_PER_SOURCE=3
DIGEST_MAX_ITEMS=30

# Окно времени, когда можно присылать дайджест (не присылать ночью).
# DIGEST_FROM_HOUR=0 и DIGEST_UNTIL_HOUR=0 — круглосуточно.
DIGEST_FROM_HOUR=8
DIGEST_UNTIL_HOUR=23
# Часовой пояс для расписания и окна (IANA, напр. Europe/Moscow)
TIMEZONE=Europe/Moscow

# База данных
DB_PATH=news.db

# Логи
LOG_FILE=collector.log

# HTTP
HTTP_TIMEOUT_SEC=15
USER_AGENT=news-aggregator/1.0 (+https://example.com)
